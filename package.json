{
	"name": "wpmvc",
	"version": "0.0.1",
	"description": "",
	"main": "webpack.config.js",
	"engines": {
		"node": "22.19.0"
	},
	"scripts": {
		"setup": "rm -rf vendor vendor-src && composer setup && pnpm install",
		"start": "wp-scripts start",
		"start:hot": "wp-scripts start --hot",
		"format": "wp-scripts format",
		"minify": "wp-scripts build",
		"compress": "pnpm exec webpack --config dev-tools/webpack.compress.js",
		"git-compress": "pnpm exec webpack --config dev-tools/webpack.compress.git.js",
		"fixtextdomain": "grunt fixtextdomain --gruntfile dev-tools/Gruntfile.js",
		"grunt-build": "grunt build --gruntfile dev-tools/Gruntfile.js",
		"grunt-finish": "grunt screen:finish --gruntfile dev-tools/Gruntfile.js",
		"build": "composer build && pnpm minify && pnpm grunt-build && pnpm compress && pnpm grunt-finish"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wpmvc/wpmvc.git"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/wpmvc/wpmvc/issues"
	},
	"homepage": "https://github.com/wpmvc/wpmvc#readme",
	"devDependencies": {
		"@wordpress/scripts": "^30.19.0",
		"filemanager-webpack-plugin": "^8.0.0",
		"grunt": "^1.6.1",
		"grunt-checktextdomain": "^1.0.1",
		"grunt-contrib-clean": "^2.0.1",
		"grunt-wp-i18n": "^1.0.3",
		"load-grunt-tasks": "^5.1.0",
		"webpack": "^5.105.0",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@wordpress/api-fetch": "^7.31.0",
		"classnames": "^2.5.1",
		"fast-deep-equal": "^3.1.3",
		"formik": "^2.4.6",
		"immer": "^10.1.3",
		"react-helmet": "^6.1.0",
		"react-hot-toast": "^2.6.0",
		"react-icons": "^5.5.0",
		"react-loading-skeleton": "^3.5.0",
		"react-router-dom": "^7.9.3",
		"react-select": "^5.10.2",
		"sprintf-js": "^1.1.3",
		"uuid": "^13.0.0",
		"yup": "^1.7.1"
	}
}